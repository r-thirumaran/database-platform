<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.dbplatform</groupId>
        <artifactId>dbp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dbp-control-plane</artifactId>
    <packaging>jar</packaging>
    <name>dbp-control-plane</name>
    <description>
        Control plane of the Database Access Platform: configuration, identity, routing and credentials;
        metadata plane (catalogue, ownership, producer/consumer graph, impact analysis); telemetry sink;
        database collectors; serves the UI build.
    </description>

    <properties>
        <springdoc.version>2.8.9</springdoc.version>
        <start-class>org.dbplatform.controlplane.ControlPlaneApplication</start-class>
    </properties>

    <dependencies>
        <!-- Platform shared code: telemetry records, SQL analysis, internal API records -->
        <dependency>
            <groupId>org.dbplatform</groupId>
            <artifactId>dbp-common</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Schema migrations -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Connection pool (managed in the root pom) -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <!-- Metadata store drivers: H2 (dev profile) and PostgreSQL (postgres profile) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Drivers for the physical databases the collectors crawl -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- OpenAPI / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>dbp-control-plane</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- UI bundle. When dbp-ui has been built (cd dbp-ui && npm run build) its dist/ is served from
                 classpath:/static/ and replaces the placeholder index.html (resources are copied in order with
                 overwrite=true). A missing directory is skipped, so a plain API build still works. The Docker build
                 (deploy/docker/Dockerfile.control-plane) copies dist/ into src/main/resources/static/ instead; both
                 paths end up with exactly one index.html in BOOT-INF/classes/static/. -->
            <resource>
                <directory>${project.basedir}/../dbp-ui/dist</directory>
                <targetPath>static</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <overwrite>true</overwrite>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${start-class}</mainClass>
                    <!-- The repackaged executable replaces the module's MAIN artifact (build log: "Replacing main artifact
                         target/dbp-control-plane.jar with repackaged archive"), so `mvn install` publishes the runnable jar as
                         dbp-control-plane-<version>.jar and the same file stays at the fixed path target/dbp-control-plane.jar
                         (Dockerfile.control-plane and dbp-integration-tests use that path). The thin classes jar remains next
                         to it as target/dbp-control-plane.jar.original and is never installed. Do not set a classifier or
                         attach=false here: that would publish the thin jar again. -->
                    <attach>true</attach>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Xmx1024m -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
