# ---------------------------------------------------------------------------------------------
# deploy/.env.example  --  copy to deploy/.env and adjust. docker compose reads deploy/.env
# automatically (the project directory is the directory of docker-compose.yml).
# Every variable used by docker-compose.yml is listed here with its default.
# ---------------------------------------------------------------------------------------------

# ----- Demo databases ------------------------------------------------------------------------
# SYS/SYSTEM password of Oracle Database Free (required by the image, no default)
ORACLE_PASSWORD=ChangeMe_Oracle1
# Demo accounts created by demo/sql/*; the same values are given to the control plane
# (credential provider ENV) and to the example applications, so everything stays in sync.
SALES_PASSWORD=Sales#Demo2026
SALES_APP_PASSWORD=SalesApp#Demo2026
DBP_COLLECTOR_PASSWORD=Collector#Demo2026
# PostgreSQL superuser password (postgres:17 image) and the control-plane metadata db owner "dbp"
POSTGRES_PASSWORD=postgres
DBP_DB_PASSWORD=dbp

# ----- Platform ------------------------------------------------------------------------------
# Shared token between gateway/proxy/bootstrap and the control plane (header X-DBP-Service-Token)
DBP_SERVICE_TOKEN=dev-service-token
# Key used by the control plane to encrypt INLINE credentials at rest (any string >= 32 chars)
DBP_MASTER_KEY=change-me-change-me-change-me-32chars
# none | basic  (public API/UI protection of the control plane)
DBP_SECURITY_MODE=none
# Load the synthetic demo dataset of the control plane (UI demo mode). Off: only real telemetry.
DBP_DEMO_SEED_ENABLED=false
# Raw telemetry retention in the control plane
DBP_TELEMETRY_RETENTION_HOURS=72
# Force bootstrap to generate new API keys even when deploy/.generated/examples.env exists
DBP_BOOTSTRAP_FORCE=false
# Image tag used for locally built images
DBP_VERSION=0.1.0-SNAPSHOT
DBP_IMAGE_PREFIX=dbp

# ----- Host ports ----------------------------------------------------------------------------
CONTROL_PLANE_HOST_PORT=8080
GATEWAY_HOST_PORT=7420
GATEWAY_ADMIN_HOST_PORT=7421
PROXY_ORACLE_HOST_PORT=1521
PROXY_POSTGRES_HOST_PORT=5432
PROXY_ADMIN_HOST_PORT=7431
ORACLE_HOST_PORT=1522
POSTGRES_HOST_PORT=5433
ORDERS_DIRECT_HOST_PORT=8091
ORDERS_PROXY_HOST_PORT=8092
ORDERS_GATEWAY_HOST_PORT=8093
LEGACY_HOST_PORT=8094
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# ----- Examples ------------------------------------------------------------------------------
# HikariCP pool size of each orders-service variant (10 x 3 variants + legacy 5 = 35 Oracle sessions direct/proxy)
ORDERS_POOL_SIZE=10
LEGACY_POOL_SIZE=5
# reporting-batch (profile "batch", run on demand). Defaults go through the gateway with the API
# key generated by bootstrap. Override BATCH_JDBC_* to run it direct or through the proxy:
#   BATCH_JDBC_URL=jdbc:oracle:thin:@//oracle:1521/FREEPDB1            BATCH_JDBC_USER=SALES_APP  BATCH_JDBC_PASSWORD=${SALES_APP_PASSWORD}
#   BATCH_JDBC_URL=jdbc:oracle:thin:@//proxy:1521/sales.reporting-batch BATCH_JDBC_USER=SALES_APP  BATCH_JDBC_PASSWORD=${SALES_APP_PASSWORD}
BATCH_JDBC_URL=jdbc:dbp://gateway:7420/sales
BATCH_JDBC_USER=reporting-batch
BATCH_JDBC_PASSWORD=
BATCH_CONNECTIONS=20
BATCH_DURATION_SECONDS=60
BATCH_ENGINE=ORACLE

# ----- Monitoring ----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
