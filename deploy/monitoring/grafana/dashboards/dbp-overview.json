      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dbp-prometheus"
          },
          "expr": "sum(dbp_gateway_logical_sessions{datasource=~\"$datasource\"})",
          "legendFormat": "logical sessions",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dbp-prometheus"
          },
          "expr": "sum(dbp_gateway_pinned_sessions{datasource=~\"$datasource\"})",
          "legendFormat": "pinned sessions",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dbp-prometheus"
          },
          "expr": "sum(dbp_gateway_pool_total{datasource=~\"$datasource\"})",
