    {
      "id": 7,
      "type": "stat",
      "title": "Error ratio (gateway, 5m)",
      "description": "Failed statements / all statements. >1% warning, >5% critical.",
      "datasource": {
        "type": "prometheus",
        "uid": "dbp-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#008300",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 0.01
              },
              {
                "color": "#e66767",
                "value": 0.05
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dbp-prometheus"
          },
          "expr": "sum(rate(dbp_gateway_statements_total{success=\"false\",datasource=~\"$datasource\",application=~\"$application\"}[5m])) / clamp_min(sum(rate(dbp_gateway_statements_total{datasource=~\"$datasource\",application=~\"$application\"}[5m])), 1e-9)",
          "legendFormat": "errors",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
