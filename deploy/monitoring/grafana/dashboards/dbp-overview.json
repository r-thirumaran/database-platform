{
  "uid": "dbp-overview",
  "title": "DBP overview",
  "description": "Database Access Platform: connections through proxy and gateway, logical vs physical, statements, latency, pools, governance, client-side Hikari pools.",
  "tags": [
    "dbp"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "DBP datasource",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dbp-prometheus"
        },
        "query": {
          "query": "label_values(dbp_gateway_logical_sessions, datasource)",
          "refId": "ds"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dbp-prometheus"
        },
        "query": {
          "query": "label_values(dbp_gateway_statements_total, application)",
          "refId": "app"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
