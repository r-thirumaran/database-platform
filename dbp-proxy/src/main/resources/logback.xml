<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="org.dbplatform.proxy" level="${DBP_LOG_LEVEL:-INFO}"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
