<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.dbplatform</groupId>
        <artifactId>dbp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dbp-examples</artifactId>
    <packaging>pom</packaging>
    <name>dbp-examples</name>
    <description>
        Example applications of the Database Access Platform: a Spring Boot service that runs unchanged in
        direct / proxy / gateway mode, a legacy Oracle application onboarded through the proxy, and a
        plain-Java batch job that shows the many-logical-to-few-physical connection effect of the gateway.
    </description>

    <modules>
        <module>orders-service</module>
        <module>reporting-batch</module>
        <module>legacy-reporting</module>
    </modules>

    <!--
      Build without the reactor (e.g. before dbp-jdbc has been built):
        mvn -f dbp-examples/pom.xml package -DskipTests -Ddbp.jdbc.skip
      Full build with the platform driver bundled (needed for gateway mode):
        mvn -pl dbp-examples/orders-service,dbp-examples/reporting-batch -am package -DskipTests
    -->
</project>
